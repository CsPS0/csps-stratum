{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "\u256d\u2500\ue0b2",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#000000",
          "background": "#d6d6d6",
          "type": "os",
          "style": "diamond"
        },
        {
          "options": {
            "home_icon": "~",
            "style": "full"
          },
          "template": " \uf07c {{ .Path }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#686b6f",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#7f7f7f",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#9c9c9c{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#878787{{ end }}",
            "{{ if gt .Ahead 0 }}#c2c2c2{{ end }}",
            "{{ if gt .Behind 0 }}#7f7f7f{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "fetch_version": true
          },
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \ue718 ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "#8f8f8f",
          "type": "node",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue627 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b2",
          "background": "#8b8b8b",
          "type": "go",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue624 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b2",
          "background": "#646464",
          "type": "julia",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue235 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b2",
          "background": "#dbdbdb",
          "type": "python",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue791 ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "#333333",
          "type": "ruby",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": false
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uf0e7",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "#b3b3b3",
          "type": "azfunc",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "display_default": false
          },
          "template": " {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} \ue7ad ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#acacac{{end}}",
            "{{if contains \"jan\" .Profile}}#4a4a4a{{end}}"
          ],
          "invert_powerline": true
        },
        {
          "template": " \uf0ad ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b2",
          "background": "#f4f4f4",
          "type": "root",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "template": " {{ .FormattedMs }} \uf252 ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b2",
          "background": "#9c9c9c",
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }}{{ reason .Code }}{{ else }}\uf42e{{ end }} ",
          "foreground": "#d6d6d6",
          "powerline_symbol": "\ue0b2",
          "background": "#000000",
          "type": "status",
          "style": "powerline",
          "background_templates": [
            "{{ if gt .Code 0 }}#464646{{ end }}"
          ],
          "invert_powerline": true
        },
        {
          "trailing_diamond": "\ue0b0\u2500\u256e",
          "template": " {{ .CurrentDate | date .Format }} \uf017 ",
          "foreground": "#000000",
          "background": "#d6d6d6",
          "type": "time",
          "style": "diamond",
          "invert_powerline": true
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u2570\u2500",
          "foreground": "#d6d6d6",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "template": "\u2500\u256f",
          "foreground": "#d6d6d6",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
