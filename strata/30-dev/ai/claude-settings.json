{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "PowerShell(git push --force)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(Remove-Item *-Recurse*-Force*)",
      "PowerShell(Remove-Item *-Force*-Recurse*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease*)",
      "PowerShell(git push --force-with-lease*)",
      "Bash(flutter build *)",
      "Bash(dart compile *)",
      "PowerShell(flutter build *)",
      "PowerShell(dart compile *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File C:/Users/<you>/.claude/hooks/guard-destructive.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Pala release builds: in the pala repo (including its subfolders and git worktrees), do not run any flutter build or dart compile command unless my current message names that build. Release binaries come from CI. A request to test or deploy does not count as a request to build."
    ],
    "environment": [
      "$defaults",
      "Source control: repos I own under github.com/CsPS0. Forks there contain third-party code, so treat their upstream code as external",
      "Deploy target: Vercel team csps-productions",
      "Primary use: personal and school software development on Windows 11 (Flutter, web, Roblox, Minecraft modding)",
      "Local repos: D:\\REPOS\\<name>; routine reads and edits inside the current repo are expected day-to-day work",
      "Repository visibility: all CsPS0 repos are PUBLIC except the private ones named in the live config. Never copy content from a private repo into a public one, and never push credentials or personal data to any repo"
    ]
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-mem@thedotmack": false,
    "commit-commands@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "ponytail@ponytail": false,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": false,
  "theme": "dark",
  "switchModelsOnFlag": true
}
