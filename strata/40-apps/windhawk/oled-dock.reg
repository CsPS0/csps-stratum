Windows Registry Editor Version 5.00

; OLED dock without LiquidGlass2 (csps-stratum). LiquidGlass2 capped the dock at
; screen width - 2 x (tray width + 50), so 32 pinned apps only fit as small icons. This drops the
; theme and draws the same floating black pill with plain styles and no width cap.
; Import elevated. Rules 0-24 (black blur colours, monochrome icons) are unchanged.

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler\Settings]
"theme"=""

; dock pill: black blur fill and faint border from rule 1, now rounded
"controlStyles[1].styles[2]"="RadiusX=18"
"controlStyles[1].styles[3]"="RadiusY=18"
"controlStyles[1].styles[4]"="StrokeThickness=1"

; tray: collapsed instead of Width=0, so it reserves no space
"controlStyles[25].target"="SystemTray.SystemTrayFrame"
"controlStyles[25].styles[0]"="Visibility=Collapsed"
"controlStyles[25].styles[1]"=-
"controlStyles[25].styles[2]"=-

; the pill: centred, sized to the apps, floating 4 px above the edge (left margin: see rule 29). The top margin`r`n; is 20: the taskbar is 76 px tall (taskbar-icon-size) so a bouncing icon has 16 px of headroom above the pill.
"controlStyles[26].target"="Taskbar.TaskbarFrame > Grid#RootGrid"
"controlStyles[26].styles[0]"="HorizontalAlignment=Center"
"controlStyles[26].styles[1]"="Width=Auto"
"controlStyles[26].styles[2]"="Padding=12,0,12,0"
"controlStyles[26].styles[3]"="Margin=58,20,0,4"
"controlStyles[26].styles[4]"="Background:=Transparent"

; no stock top edge line
"controlStyles[27].target"="Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke"
"controlStyles[27].styles[0]"="Visibility=Collapsed"

; running dots like the macOS Dock, monochrome (attention is white, not red)
"controlStyles[28].target"="Grid#IconPanel@RunningIndicatorStates > Rectangle#RunningIndicator, Taskbar.TaskListLabeledButtonPanel@RunningIndicatorStates > Rectangle#RunningIndicator"
"controlStyles[28].styles[0]"="Width=5"
"controlStyles[28].styles[1]"="Height=4"
"controlStyles[28].styles[2]"="RadiusX=2"
"controlStyles[28].styles[3]"="RadiusY=2"
"controlStyles[28].styles[4]"="Fill=#E6E6E6"
"controlStyles[28].styles[5]"="Fill@Inactive=#80FFFFFF"
"controlStyles[28].styles[6]"="Fill@RequestingAttention=#FFFFFFFF"

; the dock reserves a fixed 58 px after the last app (it isn't the gripper, and it isn't room for
; a new app: it stays 58 px with more apps open). End the pill's background before it (rule 29)
; and shift the dock right by the same 58 px (rule 26's left margin), so the pill is centred and
; both ends have the same 12 px padding.
"controlStyles[29].target"="Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground"
"controlStyles[29].styles[0]"="Margin=0,0,58,0"
"controlStyles[29].styles[1]"=-

; no square backdrop behind app icons: transparent in every hover/pressed state (rules 33-34) and in the
; running-indicator states, including Windows' red/orange 'needs attention' fill (rule 32). The macOS-style
; dots (rule 28) and the attention bounce mod mark running and attention apps instead.
"controlStyles[32].target"="Grid#IconPanel@RunningIndicatorStates > Border#BackgroundElement, Taskbar.TaskListLabeledButtonPanel@RunningIndicatorStates > Border#BackgroundElement"
"controlStyles[32].styles[0]"="Background=Transparent"
"controlStyles[32].styles[1]"="BorderThickness=0"
"controlStyles[32].styles[2]"="Background@NoRunningIndicator=Transparent"
"controlStyles[32].styles[3]"="Background@ActiveRunningIndicator=Transparent"
"controlStyles[32].styles[4]"="Background@InactiveRunningIndicator=Transparent"
"controlStyles[32].styles[5]"="Background@RequestingAttention=Transparent"
"controlStyles[32].styles[6]"="Background@RequestingAttentionPointerOver=Transparent"
"controlStyles[32].styles[7]"="Background@RequestingAttentionRunningIndicator=Transparent"
"controlStyles[33].target"="Taskbar.TaskListButtonPanel@CommonStates > Border#BackgroundElement, Taskbar.TaskListButtonPanel@CommonStates > Grid > Border#BackgroundElement"
"controlStyles[33].styles[0]"="Background=Transparent"
"controlStyles[33].styles[1]"="BorderThickness=0"
"controlStyles[33].styles[2]"="Background@PointerOver=Transparent"
"controlStyles[33].styles[3]"="Background@Pressed=Transparent"
"controlStyles[33].styles[4]"="Background@ActivePointerOver=Transparent"
"controlStyles[33].styles[5]"="Background@InactivePointerOver=Transparent"
"controlStyles[33].styles[6]"="Background@ActivePressed=Transparent"
"controlStyles[33].styles[7]"="Background@InactivePressed=Transparent"
"controlStyles[33].styles[8]"="Background@ActiveNormal=Transparent"
"controlStyles[33].styles[9]"="Background@InactiveNormal=Transparent"
"controlStyles[34].target"="Grid#IconPanel@CommonStates > Border#BackgroundElement, Taskbar.TaskListLabeledButtonPanel@CommonStates > Border#BackgroundElement"
"controlStyles[34].styles[0]"="Background=Transparent"
"controlStyles[34].styles[1]"="BorderThickness=0"
"controlStyles[34].styles[2]"="Background@PointerOver=Transparent"
"controlStyles[34].styles[3]"="Background@Pressed=Transparent"
"controlStyles[34].styles[4]"="Background@ActivePointerOver=Transparent"
"controlStyles[34].styles[5]"="Background@InactivePointerOver=Transparent"
"controlStyles[34].styles[6]"="Background@ActivePressed=Transparent"
"controlStyles[34].styles[7]"="Background@InactivePressed=Transparent"
"controlStyles[34].styles[8]"="Background@ActiveNormal=Transparent"
"controlStyles[34].styles[9]"="Background@InactiveNormal=Transparent"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler]
"Disabled"=dword:00000000
"SettingsChangeTime"=dword:6b02be7b
; taller taskbar window for the bounce headroom (the pill itself stays 52 px tall)
[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\taskbar-icon-size\Settings]
"TaskbarHeight"=dword:0000004c

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\taskbar-icon-size]
"SettingsChangeTime"=dword:6b02be7b

; magnify every taskbar button. 'Apps only' (mode 3) was for LiquidGlass2's tray-in-dock layout; it also
; skipped LibreOffice, whose app ID (TheDocumentFoundation.LibreOffice.Startcenter) contains 'start' and
; matches the mod's Start button check. The tray is collapsed now and Windows' own buttons are hidden.
[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\taskbar-dock-animation\Settings]
"ExcludeSystemButtonsMode"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\taskbar-dock-animation]
"SettingsChangeTime"=dword:6b02be7b
