Windows Registry Editor Version 5.00

; OLED dock without LiquidGlass2 (csps-stratum). LiquidGlass2 capped the dock at
; screen width - 2 x (tray width + 50), so 32 pinned apps only fit as small icons. This drops the
; theme and draws the same floating black pill with plain styles and no width cap.
; Import elevated. Rules 0-24 (black blur colours, monochrome icons) are unchanged.

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler\Settings]
"theme"=""

; dock pill: black blur fill and faint border from rule 1, now rounded
"controlStyles[1].styles[2]"="RadiusX=18"
"controlStyles[1].styles[3]"="RadiusY=18"
"controlStyles[1].styles[4]"="StrokeThickness=1"

; tray: collapsed instead of Width=0, so it reserves no space
"controlStyles[25].target"="SystemTray.SystemTrayFrame"
"controlStyles[25].styles[0]"="Visibility=Collapsed"
"controlStyles[25].styles[1]"=-
"controlStyles[25].styles[2]"=-

; the pill: centred, sized to the apps, floating 4 px above the edge (left margin: see rule 29)
"controlStyles[26].target"="Taskbar.TaskbarFrame > Grid#RootGrid"
"controlStyles[26].styles[0]"="HorizontalAlignment=Center"
"controlStyles[26].styles[1]"="Width=Auto"
"controlStyles[26].styles[2]"="Padding=12,0,12,0"
"controlStyles[26].styles[3]"="Margin=58,4,0,4"
"controlStyles[26].styles[4]"="Background:=Transparent"

; no stock top edge line
"controlStyles[27].target"="Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke"
"controlStyles[27].styles[0]"="Visibility=Collapsed"

; running dots like the macOS Dock, monochrome (attention is white, not red)
"controlStyles[28].target"="Grid#IconPanel@RunningIndicatorStates > Rectangle#RunningIndicator, Taskbar.TaskListLabeledButtonPanel@RunningIndicatorStates > Rectangle#RunningIndicator"
"controlStyles[28].styles[0]"="Width=5"
"controlStyles[28].styles[1]"="Height=4"
"controlStyles[28].styles[2]"="RadiusX=2"
"controlStyles[28].styles[3]"="RadiusY=2"
"controlStyles[28].styles[4]"="Fill=#E6E6E6"
"controlStyles[28].styles[5]"="Fill@Inactive=#80FFFFFF"
"controlStyles[28].styles[6]"="Fill@RequestingAttention=#FFFFFFFF"

; the dock reserves a fixed 58 px after the last app (it isn't the gripper, and it isn't room for
; a new app: it stays 58 px with more apps open). End the pill's background before it (rule 29)
; and shift the dock right by the same 58 px (rule 26's left margin), so the pill is centred and
; both ends have the same 12 px padding.
"controlStyles[29].target"="Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground"
"controlStyles[29].styles[0]"="Margin=0,0,58,0"
"controlStyles[29].styles[1]"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler]
"Disabled"=dword:00000000
"SettingsChangeTime"=dword:6b02a570