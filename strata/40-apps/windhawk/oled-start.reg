Windows Registry Editor Version 5.00

; OLED Start menu for the OnlySearch (Minimal) theme (csps-stratum): the theme keeps only the search
; box, in a grey acrylic pane with the colour search icon. These rules make the pane black with a
; faint border, the search field dark grey, and swap the colour icon for the monochrome search glyph.
; Import elevated, then restart the Start menu (Stop-Process -Name StartMenuExperienceHost).
; Rules 0-24 (black blur colours for the search page and flyouts) are unchanged.

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-start-menu-styler\Settings]
"theme"="OnlySearch_variant_Minimal"

; pane: pure black, faint border
"controlStyles[25].target"="Grid#MainMenu > Border#AcrylicBorder"
"controlStyles[25].styles[0]"="Background:=<SolidColorBrush Color=\"#FF000000\"/>"
"controlStyles[25].styles[1]"="BorderBrush:=<SolidColorBrush Color=\"#33FFFFFF\"/>"
"controlStyles[25].styles[2]"="BorderThickness=1"

; search field: dark grey, a shade lighter on hover
"controlStyles[26].target"="StartMenu.SearchBoxToggleButton#SearchBoxToggleButton > Grid@CommonStates > Border#BorderElement"
"controlStyles[26].styles[0]"="Background:=<SolidColorBrush Color=\"#FF141414\"/>"
"controlStyles[26].styles[1]"="Background@PointerOver:=<SolidColorBrush Color=\"#FF1C1C1C\"/>"
"controlStyles[26].styles[2]"="Background@Pressed:=<SolidColorBrush Color=\"#FF1C1C1C\"/>"
"controlStyles[26].styles[3]"="BorderBrush:=<SolidColorBrush Color=\"#26FFFFFF\"/>"

; rule 11 put a blur behind the field; the field draws its own fill now
"controlStyles[11].styles[0]"="Background:=<SolidColorBrush Color=\"#00000000\"/>"

; colour search icon out, monochrome glyph in
"controlStyles[27].target"="Image#SearchIconOn, Image#SearchIconOff"
"controlStyles[27].styles[0]"="Visibility=Collapsed"
"controlStyles[28].target"="StartMenu.SearchBoxToggleButton#SearchBoxToggleButton > Grid > FontIcon#SearchGlyph"
"controlStyles[28].styles[0]"="Visibility=Visible"
"controlStyles[28].styles[1]"="Foreground:=<SolidColorBrush Color=\"#B3FFFFFF\"/>"

; placeholder text: grey
"controlStyles[29].target"="StartMenu.SearchBoxToggleButton#SearchBoxToggleButton > Grid > ContentPresenter#ContentPresenter > TextBlock#PlaceholderText"
"controlStyles[29].styles[0]"="Foreground:=<SolidColorBrush Color=\"#8CFFFFFF\"/>"
