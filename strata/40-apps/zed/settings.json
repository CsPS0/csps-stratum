{
  "theme": "One Dark Pro Max",
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "server_url": "https://zed.dev",
  "proxy": "",

  "ui_font_family": "JetBrainsMono NF",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono NF",
  "buffer_font_size": 15,

  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "soft_wrap": "editor_width",
  "scroll_beyond_last_line": "off",
  "colorize_brackets": true,
  "show_whitespaces": "selection",

  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
  },

  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "redact_private_values": true,

  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },
  "code_lens": "on",

  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 300,
    },
  },

  "terminal": {
    "dock": "bottom",
    "copy_on_select": true,
    "font_family": "JetBrainsMono NF",
    "font_size": 14,
  },

  "project_panel": {
    "hide_gitignore": false,
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
}
